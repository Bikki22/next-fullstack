// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MERCHANT
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum StoreStatus {
  PENDING
  APPROVED
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  name         String
  phone        String?
  avatarUrl    String?
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  addresses Address[]
  store     Store?

  @@index([role])
  @@index([createdAt])
}

model Store {
  id        String      @id @default(cuid())
  ownerId   String      @unique
  name      String
  slug      String      @unique
  status    StoreStatus @default(PENDING)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products Product[]

  @@index([status])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())

  products Product[]
}

model Product {
  id          String        @id @default(cuid())
  storeId     String
  categoryId  String?
  name        String
  slug        String
  description String?
  // Integer cents, like every other amount in the app — see lib/format.ts.
  priceCents  Int
  stock       Int           @default(0)
  images      String[]
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  store    Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Two stores may each sell a "blue-shirt"; one store may not list it twice.
  @@unique([storeId, slug])
  @@index([status])
  @@index([categoryId])
  @@index([storeId, status])
  @@index([createdAt])
  @@index([priceCents])
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String?
  fullName   String
  phone      String
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String  @default("IN")
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
